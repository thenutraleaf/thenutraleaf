---
import '../styles.css';
const { title, path } = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{title} | The NutraLeaf</title><link rel="canonical" href={'https://thenutraleaf.com'+path}><link rel="icon" href="/favicon.png"></head>
<body><header><div class="wrap nav"><a class="logo" href="/"><img src="/images/logo.webp" alt="The NutraLeaf" width="150" height="72"></a><a class="btn ghost" href="/">Back to website</a></div></header><main class="wrap doc"><h1>{title}</h1><slot/></main></body></html>
